@inherits LayoutComponentBase
@using ShopInventory.App.Services
@inject LicenseService LicenseService
@inject ShopSettingsService ShopSettingsService
@inject IServiceProvider ServiceProvider


@if (appState == AppState.Splash)
{
    <!-- SPLASH SCREEN -->
    <div class="splash-screen @(splashFading ? "fade-out" : "")">
        <div class="splash-content">
           <div class="gear-wrap">
    @if (!string.IsNullOrWhiteSpace(shopLogo))
    {
        <img
            src="@shopLogo"
            alt="@shopName"
            class="splash-shop-logo" />
    }
    else
    {
        <svg
            class="gear-spin"
            viewBox="0 0 100 100"
            xmlns="http://www.w3.org/2000/svg">

            <path
                fill="#cc0000"
                d="M43.3 5.6l-3.1 9.5c-2.3.6-4.5 1.5-6.5 2.7L24.4 13l-9 9 4.8 9.3c-1.2 2-2.1 4.2-2.7 6.5l-9.5 3.1v12.7l9.5 3.1c.6 2.3 1.5 4.5 2.7 6.5L15.4 73l9 9 9.3-4.8c2 1.2 4.2 2.1 6.5 2.7l3.1 9.5h12.7l3.1-9.5c2.3-.6 4.5-1.5 6.5-2.7l9.3 4.8 9-9-4.8-9.3c1.2-2 2.1-4.2 2.7-6.5l9.5-3.1V43.3l-9.5-3.1c-.6-2.3-1.5-4.5-2.7-6.5l4.8-9.3-9-9-9.3 4.8c-2-1.2-4.2-2.1-6.5-2.7l-3.1-9.5H43.3z" />
        </svg>
    }
</div>

           <div class="splash-title-wrap">
    <div class="splash-divider">
        <span class="divider-line"></span>
        <span class="divider-text">@shopName</span>
        <span class="divider-line"></span>
    </div>

    <div class="splash-sub">
        Inventory &amp; Billing System
    </div>
</div>

            <div class="splash-loader">
                <div class="loader-bar"></div>
            </div>
        </div>
    </div>
}
else if (appState == AppState.Activation)
{
    <!-- LICENSE ACTIVATION SCREEN -->
    <div class="activate-page">
        <div class="activate-card">
           <div class="app-logo">

    <div class="logo-icon">
        @if (!string.IsNullOrWhiteSpace(shopLogo))
        {
            <img
                src="@shopLogo"
                alt="@shopName"
                class="activation-shop-logo" />
        }
        else
        {
            <svg viewBox="0 0 100 100" width="32" height="32">
                <path
                    fill="#cc0000"
                    d="M43.3 5.6l-3.1 9.5c-2.3.6-4.5 1.5-6.5 2.7L24.4 13l-9 9 4.8 9.3c-1.2 2-2.1 4.2-2.7 6.5l-9.5 3.1v12.7l9.5 3.1c.6 2.3 1.5 4.5 2.7 6.5L15.4 73l9 9 9.3-4.8c2 1.2 4.2 2.1 6.5 2.7l3.1 9.5h12.7l3.1-9.5c2.3-.6 4.5-1.5 6.5-2.7l9.3 4.8 9-9-4.8-9.3c1.2-2 2.1-4.2 2.7-6.5l9.5-3.1V43.3l-9.5-3.1c-.6-2.3-1.5-4.5-2.7-6.5l4.8-9.3-9-9-9.3 4.8c-2-1.2-4.2-2.1-6.5-2.7l-3.1-9.5H43.3z" />
            </svg>
        }
    </div>

    <div>
        <div class="app-name">@shopName</div>
        <div class="app-tagline">
            Inventory &amp; Billing System
        </div>
    </div>

</div>

            @if (licenseMessage != "")
            {
                <div class="alert @licenseAlertClass">
                    <strong>@licenseTitle</strong>
                    <p>@licenseMessage</p>
                </div>
            }

            @if (canStartTrial)
            {
                <div class="trial-section">
                    <div class="trial-header">
                        <span class="trial-icon">🎁</span>
                        <div class="trial-text">
                            <div class="trial-title">Start 7-Day Free Trial</div>
                            <div class="trial-desc">Access all features free for 7 days. No credit card required.</div>
                        </div>
                    </div>
                    <button class="btn-trial" @onclick="StartFreeTrial" disabled="@isStartingTrial">
                        @(isStartingTrial ? "Activating Trial..." : "🚀 Start 7-Day Free Trial")
                    </button>
                </div>
                <div class="or-separator"><span>OR ACTIVATE FULL LICENSE</span></div>
            }
            else if (isTrialExpired)
            {
                <div class="trial-expired-box">
                    <div class="te-title">⏳ 7-Day Free Trial Expired</div>
                    <div class="te-desc">Your free trial has ended. Please purchase a license key to continue using ShopInventory.</div>
                </div>
            }

            <div class="machine-id-box">
                <div class="mid-label">Your Machine ID <span class="mid-hint">(send to your provider)</span></div>
                <div class="mid-value">@machineId</div>
                <button class="btn-copy" @onclick="CopyMachineId">@(copied ? "✓ Copied!" : "📋 Copy")</button>
            </div>

            <div class="form-section">
                <label class="input-label">Enter License Key</label>
                <textarea class="key-input" placeholder="Paste your license key here..." @bind="licenseKey" rows="3"></textarea>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-msg">@errorMessage</div>
                }
                <button class="btn-activate" @onclick="Activate" @disabled="isActivating">
                    @(isActivating ? "Activating..." : "Activate License")
                </button>
            </div>

            <div class="contact-box">
                <div class="contact-box-title">Need a license key?</div>
                <div class="contact-box-row">
                    <span>📱 WhatsApp</span>
                    <span>+92 342 3896298</span>
                </div>
                <div class="contact-box-row">
                    <span>📧 Email</span>
                    <span>umer23672@gmail.com</span>
                </div>
                <div class="contact-box-note">Send your Machine ID above to get activated</div>
            </div>
        </div>
    </div>
}
else
{
    <!-- NORMAL APP -->
    @if (isTrialActive)
    {
        <div class="trial-banner" style="background-color: @themeColor;">
            <div class="tb-content">
                <span>⏱️ <strong>7-Day Free Trial Active:</strong> @trialDaysRemaining days remaining</span>
                <span class="tb-hint">Renew or upgrade to permanent license anytime: +92 342 3896298</span>
            </div>
        </div>
    }
    <div class="app-shell">
        <aside class="sidebar">
            <NavMenu />
        </aside>
        <main class="main-content">
            <div class="content-wrap">
                @Body
            </div>
        </main>
    </div>
}

@code {
    private enum AppState { Splash, Activation, App }
    private string shopName = "Shop Inventory";
    private string? shopLogo;
    private string themeColor = "#cc0000";
    private AppState appState = AppState.Splash;
    private bool splashFading = false;
    private string machineId = "";
    private string licenseKey = "";
    private string errorMessage = "";
    private string licenseMessage = "";
    private string licenseTitle = "";
    private string licenseAlertClass = "";
    private bool isActivating = false;
    private bool isStartingTrial = false;
    private bool canStartTrial = false;
    private bool isTrialActive = false;
    private bool isTrialExpired = false;
    private int trialDaysRemaining = 0;
    private bool copied = false;

    protected override async Task OnInitializedAsync()
    {
        var settings = await ShopSettingsService.GetSettingsAsync();

        if (settings is not null)
        {
            if (!string.IsNullOrWhiteSpace(settings.ShopName))
            {
                shopName = settings.ShopName;
            }
            if (!string.IsNullOrWhiteSpace(settings.ThemeColor))
            {
                themeColor = settings.ThemeColor;
            }
        }

        shopLogo = await ShopSettingsService.GetLogoDataUrlAsync();
        machineId = LicenseService.GetMachineId();
        canStartTrial = LicenseService.CanStartTrial();

        await Task.Delay(2400);

        splashFading = true;
        StateHasChanged();

        await Task.Delay(400);

        var result = LicenseService.CheckCurrentLicense();
        canStartTrial = result.CanStartTrial;
        isTrialActive = result.IsValid && result.IsTrial;
        trialDaysRemaining = result.DaysRemaining;
        isTrialExpired = result.IsTrial && result.Status == LicenseStatus.Expired;

        if (result.IsValid)
        {
            appState = AppState.App;
        }
        else
        {
            appState = AppState.Activation;
            SetLicenseAlert(result.Status);
        }

        StateHasChanged();
    }

    private void SetLicenseAlert(LicenseStatus status)
    {
        switch (status)
        {
            case LicenseStatus.Expired:
                licenseTitle = isTrialExpired ? "7-Day Free Trial Expired" : "License Expired";
                licenseMessage = isTrialExpired
                    ? "Your 7-day free trial has expired. Contact AL-HAJJ Corporation below to obtain a license key."
                    : "Your license has expired. Please contact your provider to renew.";
                licenseAlertClass = "alert-expired";
                break;
            case LicenseStatus.WrongMachine:
                licenseTitle = "Wrong Machine";
                licenseMessage = "This license is registered to a different machine.";
                licenseAlertClass = "alert-error";
                break;
            case LicenseStatus.NotActivated:
                licenseTitle = "";
                licenseMessage = "";
                break;
        }
    }

    private async Task StartFreeTrial()
    {
        isStartingTrial = true;
        errorMessage = "";
        StateHasChanged();
        await Task.Delay(400);

        var result = LicenseService.StartTrial();
        if (result.IsValid)
        {
            isTrialActive = true;
            trialDaysRemaining = result.DaysRemaining;
            canStartTrial = false;

            var settings = await ShopSettingsService.GetSettingsAsync();
            var setupIsComplete = settings is not null &&
                                  settings.IsConfigured &&
                                  !string.IsNullOrWhiteSpace(settings.ShopName) &&
                                  !string.IsNullOrWhiteSpace(settings.LogoPath) &&
                                  File.Exists(settings.LogoPath);

            if (!setupIsComplete)
            {
                var window = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault();
                if (window is not null)
                {
                    window.Title = "Shop Setup";
                    window.Page = ServiceProvider.GetRequiredService<ShopSetupPage>();
                    return;
                }
            }

            appState = AppState.App;
        }
        else
        {
            errorMessage = result.Message;
            canStartTrial = result.CanStartTrial;
            isTrialExpired = result.IsTrial && result.Status == LicenseStatus.Expired;
            SetLicenseAlert(result.Status);
        }

        isStartingTrial = false;
        StateHasChanged();
    }

    private async Task Activate()
    {
        if (string.IsNullOrWhiteSpace(licenseKey))
        {
            errorMessage = "Please enter a license key.";
            return;
        }
        isActivating = true;
        errorMessage = "";
        await Task.Delay(600);

        var result = LicenseService.ValidateLicenseKey(licenseKey);
        if (result.IsValid)
        {
            isTrialActive = false;
            var settings = await ShopSettingsService.GetSettingsAsync();
            var setupIsComplete = settings is not null &&
                                  settings.IsConfigured &&
                                  !string.IsNullOrWhiteSpace(settings.ShopName) &&
                                  !string.IsNullOrWhiteSpace(settings.LogoPath) &&
                                  File.Exists(settings.LogoPath);

            if (!setupIsComplete)
            {
                var window = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault();
                if (window is not null)
                {
                    window.Title = "Shop Setup";
                    window.Page = ServiceProvider.GetRequiredService<ShopSetupPage>();
                    return;
                }
            }

            appState = AppState.App;
        }
        else
        {
            errorMessage = result.Message;
            SetLicenseAlert(result.Status);
        }
        isActivating = false;
        StateHasChanged();
    }

    private async Task CopyMachineId()
    {
        await Clipboard.Default.SetTextAsync(machineId);
        copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
        StateHasChanged();
    }
}

<style>
/* ── SPLASH ─────────────────────────────────────── */
.splash-screen {
    position: fixed; inset: 0;
    background: #111214;
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
    transition: opacity .5s ease;
}
.splash-screen.fade-out { opacity: 0; pointer-events: none; }

.splash-content { text-align: center; }

.gear-wrap {
    position: relative;
    width: 110px; height: 110px;
    margin: 0 auto 28px;
    display: flex; align-items: center; justify-content: center;
}
.gear-spin {
    width: 110px; height: 110px;
    animation: gearRotate 3s linear infinite;
    filter: drop-shadow(0 0 18px rgba(204,0,0,.5));
}
.wrench {
    position: absolute;
    width: 36px; height: 36px;
    bottom: -4px; right: -4px;
    animation: wrenchWiggle 2s ease-in-out infinite;
}
@@keyframes gearRotate { to { transform: rotate(360deg); } }
@@keyframes wrenchWiggle {
    0%,100% { transform: rotate(-10deg); }
    50% { transform: rotate(10deg); }
}

.splash-arabic {
    font-size: 28px;
    color: #ffffff;
    font-weight: 700;
    letter-spacing: .05em;
    opacity: 0;
    animation: fadeSlideUp .8s ease .4s forwards;
    direction: rtl;
}
.splash-divider {
    display: flex; align-items: center; gap: 10px;
    justify-content: center; margin: 10px 0 6px;
    opacity: 0;
    animation: fadeSlideUp .8s ease .7s forwards;
}
.divider-line {
    flex: 1; max-width: 60px;
    height: 1px; background: @themeColor;
}
.divider-text {
    font-size: 18px; font-weight: 600;
    color: @themeColor; letter-spacing: .12em;
    text-transform: uppercase;
}
.splash-sub {
    font-size: 13px; color: #666;
    letter-spacing: .1em;
    opacity: 0;
    animation: fadeSlideUp .8s ease 1s forwards;
}

.splash-loader {
    margin-top: 48px;
    width: 200px;
    height: 3px;
    background: #2a2a2a;
    border-radius: 3px;
    overflow: hidden;
    margin-left: auto; margin-right: auto;
    opacity: 0;
    animation: fadeIn .5s ease 1.2s forwards;
}
.loader-bar {
    height: 100%;
    background: @themeColor;
    border-radius: 3px;
    animation: loadProgress 2.2s ease 1.2s forwards;
    width: 0;
}
@@keyframes loadProgress { to { width: 100%; } }
@@keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
}
@@keyframes fadeIn { to { opacity: 1; } }

/* ── ACTIVATION ─────────────────────────────────── */
.activate-page {
    min-height: 100vh;
    background: #111214;
    display: flex; align-items: center; justify-content: center;
    padding: 2rem;
}
.activate-card {
    background: #1c1e22;
    border: 1px solid #2a2a2a;
    border-radius: 20px;
    padding: 2.2rem 2rem;
    width: 100%; max-width: 440px;
    box-shadow: 0 25px 60px rgba(0,0,0,.6);
}
.app-logo { display: flex; align-items: center; gap: 14px; margin-bottom: 1.5rem; }
.logo-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: #1a0000; border: 1px solid @themeColor;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}
.app-name { font-size: 18px; font-weight: 700; color: #fff; }
.app-tagline { font-size: 12px; color: #666; margin-top: 2px; }

/* ── 7-DAY TRIAL UI ─────────────────────────────────── */
.trial-section {
    background: #16202e;
    border: 1.5px solid #2563eb;
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 16px;
}
.trial-header { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
.trial-icon { font-size: 26px; }
.trial-title { font-size: 14px; font-weight: 700; color: #ffffff; }
.trial-desc { font-size: 11.5px; color: #94a3b8; line-height: 1.4; margin-top: 2px; }
.btn-trial {
    width: 100%;
    padding: 11px;
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background .2s;
}
.btn-trial:hover:not(:disabled) { background: #1d4ed8; }
.btn-trial:disabled { opacity: .6; cursor: not-allowed; }

.or-separator {
    display: flex; align-items: center; text-align: center;
    margin: 16px 0; color: #555; font-size: 11px; font-weight: 600;
}
.or-separator::before, .or-separator::after {
    content: ''; flex: 1; border-bottom: 1px solid #2a2a2a;
}
.or-separator span { padding: 0 10px; letter-spacing: .05em; }

.trial-expired-box {
    background: #2a1a00;
    border: 1px solid #d97706;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 16px;
}
.te-title { color: #fcd34d; font-weight: 700; font-size: 13px; margin-bottom: 4px; }
.te-desc { color: #cbd5e1; font-size: 11.5px; line-height: 1.4; }

.trial-banner {
    color: #ffffff;
    padding: 8px 18px;
    font-size: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}
.tb-content {
    display: flex; justify-content: space-between; align-items: center;
}
.tb-hint { opacity: 0.9; font-size: 11px; }

.alert { padding: 12px 14px; border-radius: 10px; margin-bottom: 16px; font-size: 13px; }
.alert strong { display: block; font-weight: 600; margin-bottom: 2px; color: #fff; }
.alert p { margin: 0; color: #aaa; }
.alert-expired { background: #2a1f00; border: 1px solid #f59e0b; }
.alert-error   { background: #200a0a; border: 1px solid #ef4444; }

.machine-id-box {
    background: #16181c; border: 1px solid #2a2a2a;
    border-radius: 12px; padding: 12px 14px; margin-bottom: 16px;
}
.mid-label { font-size: 11px; font-weight: 600; color: #555;
    text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
.mid-hint { font-weight: 400; color: #444; }
.mid-value { font-family: monospace; font-size: 16px; font-weight: 700;
    color: @themeColor; letter-spacing: .1em; margin-bottom: 8px; }
.btn-copy { font-size: 12px; padding: 4px 12px; border-radius: 6px;
    border: 1px solid #333; background: #222; cursor: pointer; color: #aaa; }
.btn-copy:hover { background: #2a2a2a; color: #fff; }

.form-section { margin-bottom: 16px; }
.input-label { font-size: 13px; font-weight: 500; color: #aaa; display: block; margin-bottom: 6px; }
.key-input {
    width: 100%; padding: 10px 12px; border: 1px solid #2a2a2a;
    border-radius: 10px; font-size: 13px; font-family: monospace;
    background: #16181c; resize: none; outline: none; color: #fff;
}
.key-input:focus { border-color: @themeColor; }
.error-msg { color: #ef4444; font-size: 13px; margin: 6px 0 10px; }
.btn-activate {
    width: 100%; padding: 12px; background: @themeColor; color: #fff;
    border: none; border-radius: 10px; font-size: 15px; font-weight: 600;
    cursor: pointer; margin-top: 10px;
}
.btn-activate:hover:not(:disabled) { filter: brightness(0.9); }
.btn-activate:disabled { opacity: .5; cursor: not-allowed; }
.contact-box { font-size: 12px; color: #555; margin-top: 16px;
    background: #16181c; border: 1px solid #2a2a2a; border-radius: 10px; padding: 12px 14px; }
.contact-box-title { font-size: 11px; font-weight: 600; color: #666;
    text-transform: uppercase; letter-spacing: .05em; margin-bottom: 8px; }
.contact-box-row { display: flex; justify-content: space-between;
    padding: 4px 0; color: #aaa; font-size: 12px; }
.contact-box-row span:last-child { color: @themeColor; font-weight: 600; }
.contact-box-note { margin-top: 8px; font-size: 11px; color: #444;
    text-align: center; border-top: 1px solid #2a2a2a; padding-top: 8px; }

/* ── APP SHELL ───────────────────────────────────── */
.app-shell { display: flex; height: 100vh; overflow: hidden; }
.sidebar { width: 240px; flex-shrink: 0; }
.main-content { flex: 1; overflow-y: auto; }
.content-wrap { padding: 0; }
</style>

@using ShopInventory.App.Services
@inject ShopSettingsService ShopSettingsService
@inject ShopInventory.Infrastructure.Services.CartService CartService
@inject ShopInventory.Infrastructure.Services.CartService CartService
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<div class="nav-shell">

    <a href="/" class="nav-logo-link">
        <div class="nav-logo">

            @if (!string.IsNullOrWhiteSpace(shopLogo))
            {
                <div class="shop-logo-wrap">
                    <img src="@shopLogo"
                         alt="@shopName"
                         class="shop-logo-image" />
                </div>
            }

            <div class="logo-text-wrap">
                <div class="logo-name">@shopName</div>
            </div>

        </div>
    </a>

    <div class="nav-divider"></div>

    <nav class="nav-links">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <span class="nav-dot"></span>
            <span class="nav-text">Home</span>
        </NavLink>
        <NavLink class="nav-item" href="products">
            <span class="nav-dot"></span>
            <span class="nav-text">Products</span>
        </NavLink>
        <NavLink class="nav-item" href="billing">
            <span class="nav-dot"></span>
            <span class="nav-text">Billing</span>
        </NavLink>

    </nav>
    <button class="nav-item cart-nav-btn" @onclick="GoToCart">
        <span class="nav-dot @(CartService.TotalItems > 0 ? "dot-active" : "")"></span>
        <span class="nav-text">Cart</span>
        @if (CartService.TotalItems > 0)
        {
            <span class="cart-badge">@CartService.TotalItems</span>
        }
    </button>
    <div class="nav-footer">

        <!-- Sync Button -->
        <button class="sync-btn @(_syncState)" @onclick="ManualSync" disabled="@(_syncState == "syncing")" title="@_syncTooltip">
            <span class="sync-icon-wrap">
                @if (_syncState == "syncing")
                {
                    <svg class="spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                    </svg>
                }
                else if (_syncState == "success")
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                }
                else if (_syncState == "error")
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="1 4 1 10 7 10" />
                        <polyline points="23 20 23 14 17 14" />
                        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                    </svg>
                }
            </span>
            <span class="sync-label">
                @if (_syncState == "syncing")
                {
                    <text>Syncing...</text>
                }
                else if (_syncState == "success")
                {

                    <text>Synced!</text>
                }
                else if (_syncState == "error")
                {

                    <text>Sync Failed</text>
                }
                else
                {

                    <text>Sync Now</text>
                }
            </span>
            @if (_lastSyncedAt.HasValue && _syncState == "idle")
            {
                <span class="sync-time">@_lastSyncedAt.Value.ToLocalTime().ToString("HH:mm")</span>
            }
        </button>

        <button class="close-app-btn" @onclick="@(() => showCloseWarning = true)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
            Close Application
        </button>
    </div>
</div>

<!-- Close Warning Modal -->
@if (showCloseWarning)
{
    <div class="modal-overlay" @onclick="@(() => showCloseWarning = false)">
        <div class="warn-modal" @onclick:stopPropagation="true">

            <div class="warn-icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#cc0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </div>

            <div class="warn-title">Close Application?</div>
            <div class="warn-msg">Any unsaved data will be lost. Are you sure you want to exit?</div>

            <div class="warn-actions">
                <button class="btn-cancel" @onclick="@(() => showCloseWarning = false)">Cancel</button>
                <button class="btn-confirm" @onclick="ConfirmClose">Yes, Close</button>
            </div>
        </div>
    </div>
}

@code {

    private string shopName = "Shop Inventory";
private string? shopLogo;
    private bool showCloseWarning = false;

    // ── Sync state ──
    // States: "idle" | "syncing" | "success" | "error"
    private string _syncState = "idle";
    private DateTime? _lastSyncedAt;
    private string _syncTooltip => _lastSyncedAt.HasValue
        ? $"Last synced at {_lastSyncedAt.Value.ToLocalTime():g}"
        : "Never synced";

    [Inject] private ShopInventory.Application.Interfaces.ISyncService SyncService { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartChanged += OnCartUpdated;

        var settings = await ShopSettingsService.GetSettingsAsync();

        if (settings is not null &&
            !string.IsNullOrWhiteSpace(settings.ShopName))
        {
            shopName = settings.ShopName;
        }

        shopLogo = await ShopSettingsService.GetLogoDataUrlAsync();
    }

    private async Task ManualSync()
    {
        // if (_syncState == "syncing") return;

        // _syncState = "syncing";
        // StateHasChanged();

        // try
        // {
        //     await SyncService.SyncAsync();
        //     _syncState = "success";
        //     _lastSyncedAt = DateTime.UtcNow;
        // }
        // catch
        // {
        //     _syncState = "error";
        // }

        // StateHasChanged();

        // Reset back to idle after 3 seconds
        // await Task.Delay(3000);
        // _syncState = "idle";
        // StateHasChanged();
    }
    [Inject] NavigationManager Navigation { get; set; } = default!;


    private void OnCartUpdated()
    {
        InvokeAsync(StateHasChanged);   
    }

    private void GoToCart()
    {
        Navigation.NavigateTo("/billing/create");
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= OnCartUpdated;
    }
    private void ConfirmClose()
    {
        showCloseWarning = false;
        Microsoft.Maui.Controls.Application.Current?.Quit();
    }
}


